<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets\EyeTimeTracker.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\EyeTimeTracker.Core\EyeTimeTracker.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\Fonts\NotoSansSC-VF.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\i18n\source\*.json" Link="i18n\source\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
