<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reminder_banner_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/reminder_banner_bg"
    android:padding="14dp">

    <View
        android:id="@+id/reminder_banner_band"
        android:layout_width="6dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="12dp"
        android:background="#16A67D" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/reminder_banner_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#16A67D"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/reminder_banner_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingMultiplier="1.2"
            android:textColor="#111827"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
